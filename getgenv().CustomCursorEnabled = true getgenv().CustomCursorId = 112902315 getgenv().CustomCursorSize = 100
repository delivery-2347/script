local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")

--// GLOBAL CONFIG
getgenv().CustomCursorEnabled = true
getgenv().CustomCursorId = 84556887617222
getgenv().CustomCursorSize = 20

--// CONNECTIONS
if getgenv().zapups_connections then
	for _, connection in ipairs(getgenv().zapups_connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
end

getgenv().zapups_connections = {}

local function AddConnection(connection)
	table.insert(getgenv().zapups_connections, connection)
	return connection
end

--// REMOVE OLD GUI
pcall(function()
	local old = CoreGui:FindFirstChild("CucumberCustomCursor")
	if old then
		old:Destroy()
	end
end)

local unlocked = true

--// GUI
local CursorGui = Instance.new("ScreenGui")
CursorGui.Name = "CucumberCustomCursor"
CursorGui.IgnoreGuiInset = true
CursorGui.DisplayOrder = 999999
CursorGui.ResetOnSpawn = false
CursorGui.Parent = CoreGui

local Cursor = Instance.new("ImageLabel")
Cursor.Name = "Cursor"
Cursor.BackgroundTransparency = 1
Cursor.BorderSizePixel = 0
Cursor.AnchorPoint = Vector2.new(0.5, 0.5)
Cursor.Visible = false
Cursor.Parent = CursorGui

--// Получение изображения из ID
local function ResolveCursorImage(id)
	id = tostring(id)

	-- Уже готовый Roblox URI
	if id:find("^rbxassetid://") then
		return id
	end

	-- Пробуем получить объект ассета
	local assetId = id:gsub("%D", "")

	if assetId ~= "" then
		local ok, objects = pcall(function()
			return game:GetObjects("rbxassetid://" .. assetId)
		end)

		if ok and objects then
			for _, object in ipairs(objects) do
				-- Decal / Texture
				if object:IsA("Decal") or object:IsA("Texture") then
					local texture = object.Texture

					if texture and texture ~= "" then
						return texture
					end
				end

				-- ImageLabel / ImageButton
				if object:IsA("ImageLabel") or object:IsA("ImageButton") then
					local image = object.Image

					if image and image ~= "" then
						return image
					end
				end

				-- Дочерний Decal/Texture
				local textureObject = object:FindFirstChildWhichIsA("Decal", true)
					or object:FindFirstChildWhichIsA("Texture", true)

				if textureObject then
					local texture = textureObject.Texture

					if texture and texture ~= "" then
						return texture
					end
				end
			end
		end
	end

	-- Если ассет не удалось разрешить,
	-- пробуем использовать его напрямую
	return "rbxassetid://" .. assetId
end

local LastId
local LastSize
local LastEnabled

local function UpdateCursor()
	local enabled = getgenv().CustomCursorEnabled
	local id = tostring(getgenv().CustomCursorId)
	local size = tonumber(getgenv().CustomCursorSize) or 20

	-- Изменение ID
	if id ~= LastId then
		LastId = id

		local image = ResolveCursorImage(id)

		Cursor.Image = image
	end

	-- Изменение размера
	if size ~= LastSize then
		LastSize = size
		Cursor.Size = UDim2.fromOffset(size, size)
	end

	-- Изменение enabled
	if enabled ~= LastEnabled then
		LastEnabled = enabled
	end

	if unlocked and enabled then
		Cursor.Visible = true
		UIS.MouseIconEnabled = false
	else
		Cursor.Visible = false
		UIS.MouseIconEnabled = unlocked
	end
end

local function setMouse(state)
	unlocked = state

	if unlocked then
		UIS.MouseBehavior = Enum.MouseBehavior.Default
	else
		UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
	end

	UpdateCursor()
end

--// START
setMouse(true)

--// CURSOR UPDATE
AddConnection(RunService.RenderStepped:Connect(function()
	UpdateCursor()

	if unlocked then
		local mousePos = UIS:GetMouseLocation()

		Cursor.Position = UDim2.fromOffset(
			mousePos.X,
			mousePos.Y
		)

		if UIS.MouseBehavior ~= Enum.MouseBehavior.Default then
			UIS.MouseBehavior = Enum.MouseBehavior.Default
		end
	else
		if UIS.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
			UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
	end
end))

--// TAB
AddConnection(UIS.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.Tab then
		setMouse(not unlocked)
	end
end))
